---
import Layout from '../../layouts/Layout.astro';
import { render } from 'astro:content';
import StoryHead from '../../components/StoryHead.astro';
import { url } from '../../lib/url';
import { getNotes } from '../../lib/notes';

export async function getStaticPaths() {
  const notes = await getNotes();
  return notes.map((note, i) => ({
    params: { id: note.id },
    props: { note, newer: notes[i - 1], older: notes[i + 1] },
  }));
}

const { note, newer, older } = Astro.props;
const { Content } = await render(note);
---
<Layout title={note.data.title} description={note.data.description} current="stories">
  <StoryHead kind="Note" title={note.data.title} date={note.data.date} description={note.data.description} picture={note.data.cover} back={{ href: 'stories', label: 'All stories' }} draft={note.data.draft} />
  <div class="g story-body">
    <article class="note-body"><Content /></article>
    <nav class="pager lab" aria-label="More notes">
      {older ? <a href={url(`notes/${older.id}`)}><span class="soft">← Older</span><span>{older.data.title}</span></a> : <span></span>}
      {newer ? <a href={url(`notes/${newer.id}`)}><span class="soft">Newer →</span><span>{newer.data.title}</span></a> : <span></span>}
    </nav>
  </div>
</Layout>
